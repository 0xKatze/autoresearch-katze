     return cur_graph
 
 
+_CLEAN_LOGITS = {}
+
+
+def _clean_logits(model, g):
+    """Clean-graph logits for all nodes (cached once per graph object; 1 forward total)."""
+    key = id(g)
+    if key not in _CLEAN_LOGITS:
+        with torch.no_grad():
+            _CLEAN_LOGITS[key] = model(g, g.ndata['feat'], no_grad=True).detach()
+    return _CLEAN_LOGITS[key]
+
+
+def trivial_node_attr(g, target_idx, node_budget, mode, do_normalize, model=None):
+    """Deterministic on-manifold injected feature for the trivial baseline (no optimization).
+    'neighbor_copy' = the target's own feature row (reinforces class; near-floor).
+    'random_real'   = a fixed, class-uncontrolled real node's feature (target_idx + N//2): the
+                      class-NEUTRAL on-manifold baseline (~= topology-only floor).
+    'class_shift'   = a real node of the target's SECOND-ranked clean class (cheap but ADVERSARIAL,
+                      1 clean query, zero ZO). This is the competitor ZO/diffusion must beat.
+    Deterministic in target_idx so the per-step loop and evaluate_performance produce the identical
+    injection.
+    """
+    n = g.num_nodes()
+    tgt = int(target_idx.item()) if torch.is_tensor(target_idx) else int(target_idx)
+    if mode == 'neighbor_copy':
+        src = tgt
+    elif mode == 'random_real':
+        src = (tgt + n // 2) % n
+    elif mode == 'class_shift':
+        logits = _clean_logits(model, g)
+        second = int(torch.argsort(logits[tgt], descending=True)[1].item())
+        cand = (g.ndata['label'] == second).nonzero(as_tuple=True)[0]
+        src = int(cand[0].item()) if cand.numel() > 0 else (tgt + n // 2) % n
+    else:
+        raise ValueError('unknown feat_override {}'.format(mode))
+    attr = g.ndata['feat'][src].reshape(1, -1).repeat(node_budget, 1).clone().float()
+    if do_normalize:
+        attr = F.normalize(attr, dim=1)
+    return attr.to(g.ndata['feat'].device)
+
+
 def sample_gumbel(shape, eps=1e-20, device='cuda:0'):
     U = torch.rand(shape).to(device)
     return -torch.log(-torch.log(U + eps) + eps)
